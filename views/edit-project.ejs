<%- include("partials/header") %>

<section class="form-section">
  <div class="form-container">

    <h1>Edit Service Project</h1>

    <p>Update the information for this service project.</p>

    <form action="/edit-project/<%= project.project_id %>" method="POST">

      <div class="form-group">
        <label for="title">Project Title</label>
        <input
          type="text"
          id="title"
          name="title"
          value="<%= project.title %>"
          maxlength="150"
          required
        />
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea
          id="description"
          name="description"
          maxlength="500"
          required
        ><%= project.description %></textarea>
      </div>

      <div class="form-group">
        <label for="location">Location</label>
        <input
          type="text"
          id="location"
          name="location"
          value="<%= project.location %>"
          maxlength="255"
          required
        />
      </div>

      <div class="form-group">
        <label for="date">Date</label>
        <input
          type="date"
          id="date"
          name="date"
          value="<%= project.date.toISOString().split('T')[0] %>"
          required
        />
      </div>

      <div class="form-group">
        <label for="organizationId">Organization</label>

        <select
          id="organizationId"
          name="organizationId"
          required
        >
          <option value="">Select an organization</option>

          <% organizations.forEach((organization) => { %>
            <option
              value="<%= organization.organization_id %>"
              <%= Number(organization.organization_id) === Number(project.organization_id) ? "selected" : "" %>
            >
              <%= organization.name %>
            </option>
          <% }) %>

        </select>
      </div>

      <div class="form-actions">

        <button type="submit">
          Update Project
        </button>

        <a href="/project/<%= project.project_id %>">
          Cancel
        </a>

      </div>

    </form>

  </div>
</section>

<%- include("partials/footer") %>