<%- include("partials/header") %>

<section class="page-header">
  <div>
    <span class="eyebrow">SERVICE CATEGORY</span>

    <h1><%= category.name %></h1>

    <p>
      Explore service projects in the
      <%= category.name.toLowerCase() %> category.
    </p>
  </div>
</section>

<section class="section">

  <div class="page-header">
    <div>
      <span class="eyebrow">CATEGORY PROJECTS</span>

      <h2>Projects in <%= category.name %></h2>
    </div>
  </div>

  <div class="project-list">

    <% if (projects.length > 0) { %>

      <% projects.forEach((project) => { %>

        <article class="project-card">

          <div class="project-content">

            <h3>
              <a href="/project/<%= project.project_id %>">
                <%= project.title %>
              </a>
            </h3>

            <p>
              <%= project.description %>
            </p>

            <p>
              <strong>Date:</strong>
              <%= project.date %>
            </p>

            <p>
              <strong>Location:</strong>
              <%= project.location %>
            </p>

          </div>

        </article>

      <% }) %>

    <% } else { %>

      <p>
        No projects are currently assigned to this category.
      </p>

    <% } %>

  </div>

</section>

<%- include("partials/footer") %>