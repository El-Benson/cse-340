<%- include("partials/header") %>

<% if (typeof notFound !== "undefined" && notFound) { %>

  <section class="error-page">
    <div class="error-content">
      <span class="eyebrow">404 ERROR</span>

      <h1>Page Not Found</h1>

      <p>
        Sorry, the page you are looking for does not exist.
        Please return to the home page and try again.
      </p>

      <a class="button" href="/">
        Return Home
      </a>
    </div>
  </section>

<% } else { %>

  <section class="hero">
    <div class="hero-content">
      <span class="eyebrow">SERVICE PROJECT HUB</span>

      <h1>Connecting people with meaningful service projects.</h1>

      <p>
        Discover organizations, explore service opportunities,
        and find projects that make a positive difference in
        communities.
      </p>

      <div class="hero-actions">
        <a class="button" href="/projects">
          Explore Projects
        </a>

        <a class="button button-secondary" href="/organizations">
          View Organizations
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <span class="eyebrow">WHAT WE OFFER</span>

      <h2>Explore Service Opportunities</h2>

      <p>
        Use the site to discover organizations and service
        projects based on different community needs.
      </p>
    </div>

    <div class="card-grid three-columns">

      <article class="info-card">
        <div class="card-icon">01</div>

        <h3>Organizations</h3>

        <p>
          Learn about organizations that provide meaningful
          opportunities for volunteers and communities.
        </p>

        <a href="/organizations" class="text-link">
          View organizations →
        </a>
      </article>

      <article class="info-card">
        <div class="card-icon">02</div>

        <h3>Projects</h3>

        <p>
          Explore service projects designed to address
          environmental, educational, and community needs.
        </p>

        <a href="/projects" class="text-link">
          View projects →
        </a>
      </article>

      <article class="info-card">
        <div class="card-icon">03</div>

        <h3>Categories</h3>

        <p>
          Browse service opportunities by category to find
          projects that match your interests.
        </p>

        <a href="/categories" class="text-link">
          View categories →
        </a>
      </article>

    </div>
  </section>

  <section class="callout">
    <div>
      <span class="eyebrow">MAKE A DIFFERENCE</span>

      <h2>Every service project starts with an opportunity to help.</h2>

      <p>
        Explore the available projects and discover ways
        organizations and volunteers can work together.
      </p>
    </div>

    <a class="button" href="/categories">
      Browse Categories
    </a>
  </section>

<% } %>

<%- include("partials/footer") %>