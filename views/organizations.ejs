<%- include("partials/header") %>

<section class="page-header">
  <div>
    <span class="eyebrow">ORGANIZATIONS</span>

    <h1>Our Partner Organizations</h1>

    <p>
      Discover organizations providing meaningful service opportunities
      in their communities.
    </p>

    <div class="page-actions">
      <a href="/new-organization" class="button">
        Create New Organization
      </a>
    </div>
  </div>
</section>

<section class="section">
  <div class="card-grid">

    <% if (organizations.length > 0) { %>

      <% organizations.forEach((organization) => { %>

        <article class="organization-card">

          <div class="organization-content">

            <h2>
              <a href="/organization/<%= organization.organization_id %>">
                <%= organization.name %>
              </a>
            </h2>

            <p>
              <%= organization.description %>
            </p>

            <p>
              <strong>Contact:</strong>
              <%= organization.contact_email %>
            </p>

          </div>

        </article>

      <% }) %>

    <% } else { %>

      <p>No organizations are currently available.</p>

    <% } %>

  </div>
</section>

<%- include("partials/footer") %>
