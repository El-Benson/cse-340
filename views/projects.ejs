<%- include("partials/header") %>

<section class="page-header">
  <div>
    <span class="eyebrow">SERVICE PROJECTS</span>

    <h1>Explore Service Projects</h1>

    <p>
      Discover projects that connect people with meaningful
      opportunities to serve their communities.
    </p>
  </div>
</section>

<section class="section">
  <div class="project-list">

    <% projects.forEach((project) => { %>

      <article class="project-card">

        <div class="project-category">
          <%= project.category %>
        </div>

        <div class="project-content">
          <h2><%= project.name %></h2>

          <p>
            <%= project.description %>
          </p>

          <a href="/categories" class="project-link">
            Explore Category →
          </a>
        </div>

      </article>

    <% }) %>

  </div>
</section>

<%- include("partials/footer") %>
