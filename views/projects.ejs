<%- include("partials/header") %>

<section class="page-header">
  <div>
    <span class="eyebrow">SERVICE PROJECTS</span>

    <h1>Upcoming Service Projects</h1>

    <p>
      Discover upcoming service projects provided by organizations
      serving their communities.
    </p>

    <div class="page-actions">
      <a href="/new-project" class="button">
        Create New Service Project
      </a>
    </div>
  </div>
</section>

<section class="section">
  <div class="project-list">

    <% if (projects.length > 0) { %>

      <% projects.forEach((project) => { %>

        <article class="project-card">

          <div class="project-category">
            SERVICE PROJECT
          </div>

          <div class="project-content">

            <h2>
              <a href="/project/<%= project.project_id %>">
                <%= project.title %>
              </a>
            </h2>

            <p>
              <%= project.description %>
            </p>

            <p>
              <strong>Date:</strong>
              <%= project.date %>
            </p>

            <p>
              <strong>Location:</strong>
              <%= project.location %>
            </p>

            <p>
              <strong>Organization:</strong>
              <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
              </a>
            </p>

          </div>

        </article>

      <% }) %>

    <% } else { %>

      <p>
        No upcoming service projects are currently available.
      </p>

    <% } %>

  </div>
</section>

<%- include("partials/footer") %>
