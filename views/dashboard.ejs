<%- include("partials/header") %>

<section class="page-header">
  <div>
    <span class="eyebrow">DASHBOARD</span>
    <h1>Welcome, <%= user.name %></h1>
    <p>Manage your Service Project Hub account and access available features.</p>
  </div>
</section>

<section class="section">
  <div class="card-grid">

    <article class="card">
      <h2>Account Information</h2>

      <p>
        <strong>Name:</strong>
        <%= user.name %>
      </p>

      <p>
        <strong>Email:</strong>
        <%= user.email %>
      </p>

      <p>
        <strong>Role:</strong>
        <%= user.role_name %>
      </p>
    </article>

    <article class="card">
      <h2>Service Projects</h2>

      <p>
        Browse organizations and service projects available through the
        Service Project Hub.
      </p>

      <a href="/organizations" class="button">
        View Organizations
      </a>
    </article>

    <% if (user.role_name === "admin") { %>

      <article class="card">
        <h2>Administration</h2>

        <p>
          Manage registered users and administrator-only features.
        </p>

        <a href="/users" class="button">
          View Registered Users
        </a>
      </article>

    <% } %>

  </div>
</section>


<section class="section">

  <div class="page-header">
    <div>
      <span class="eyebrow">MY VOLUNTEER PROJECTS</span>
      <h2>Projects I'm Volunteering For</h2>
      <p>Service projects you have chosen to volunteer for.</p>
    </div>
  </div>

  <% if (volunteeredProjects && volunteeredProjects.length > 0) { %>

    <div class="card-grid">

      <% volunteeredProjects.forEach((project) => { %>

        <article class="project-card">

          <div class="project-content">

            <h3>
              <a href="/project/<%= project.project_id %>">
                <%= project.title %>
              </a>
            </h3>

            <p>
              <strong>Date:</strong>
              <%= project.date %>
            </p>

            <p>
              <strong>Location:</strong>
              <%= project.location %>
            </p>

            <p>
              <strong>Organization:</strong>
              <%= project.organization_name %>
            </p>

            <div class="page-actions">

              <a
                href="/project/<%= project.project_id %>"
                class="button"
              >
                View Project
              </a>

              <form
                action="/remove-volunteer/<%= project.project_id %>"
                method="POST"
              >
                <button type="submit" class="button">
                  Remove Volunteer
                </button>
              </form>

            </div>

          </div>

        </article>

      <% }) %>

    </div>

  <% } else { %>

    <p>
      You are not currently volunteering for any service projects.
    </p>

    <a href="/projects" class="button">
      Browse Service Projects
    </a>

  <% } %>

</section>
<%- include("partials/footer") %>

