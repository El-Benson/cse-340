<%- include("partials/header") %>

<section class="page-header">
  <div>
    <span class="eyebrow">ORGANIZATION</span>

    <h1><%= organization.name %></h1>

    <p>
      <%= organization.description %>
    </p>

    <div class="page-actions">
      <a
        href="/edit-organization/<%= organization.organization_id %>"
        class="button"
      >
        Edit Organization
      </a>
    </div>
  </div>
</section>

<section class="section">

  <article class="organization-card">

    <div class="organization-content">

      <h2>Organization Details</h2>

      <p>
        <strong>Contact Email:</strong>
        <%= organization.contact_email %>
      </p>

    </div>

  </article>

</section>

<section class="section">

  <div class="page-header">
    <div>
      <span class="eyebrow">SERVICE PROJECTS</span>
      <h2>Projects</h2>
    </div>
  </div>

  <div class="project-list">

    <% if (projects.length > 0) { %>

      <% projects.forEach((project) => { %>

        <article class="project-card">

          <div class="project-content">

            <h3>
              <a href="/project/<%= project.project_id %>">
                <%= project.title %>
              </a>
            </h3>

            <p>
              <%= project.description %>
            </p>

            <p>
              <strong>Date:</strong>
              <%= project.date %>
            </p>

            <p>
              <strong>Location:</strong>
              <%= project.location %>
            </p>

          </div>

        </article>

      <% }) %>

    <% } else { %>

      <p>
        No service projects are currently associated with this organization.
      </p>

    <% } %>

  </div>

</section>

<%- include("partials/footer") %>
