<%- include("partials/header") %>

<section class="form-section">
  <div class="form-container">

    <h1>Edit Category</h1>

    <p>
      Update the name of this service project category.
    </p>

    <form
      action="/edit-category/<%= category.category_id %>"
      method="POST"
    >

      <div class="form-group">
        <label for="name">Category Name</label>

        <input
          type="text"
          id="name"
          name="name"
          value="<%= category.name %>"
          maxlength="100"
          required
        />
      </div>

      <div class="form-actions">

        <button type="submit">
          Update Category
        </button>

        <a href="/category/<%= category.category_id %>">
          Cancel
        </a>

      </div>

    </form>

  </div>
</section>

<%- include("partials/footer") %>
