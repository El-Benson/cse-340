<%- include("partials/header") %>

<section class="page-header">
  <div>
    <span class="eyebrow">SERVICE PROJECT</span>

    <h1><%= project.title %></h1>

    <p>
      <%= project.description %>
    </p>
  </div>
</section>

<section class="section">
  <article class="project-card">

    <div class="project-content">

      <h2>Project Details</h2>

      <p>
        <strong>Date:</strong>
        <%= project.date %>
      </p>

      <p>
        <strong>Location:</strong>
        <%= project.location %>
      </p>

      <p>
        <strong>Organization:</strong>
        <a href="/organization/<%= project.organization_id %>">
          <%= project.organization_name %>
        </a>
      </p>

      <div class="page-actions">

        <a
          href="/edit-project/<%= project.project_id %>"
          class="button"
        >
          Edit Project
        </a>

        <a
          href="/assign-categories/<%= project.project_id %>"
          class="button"
        >
          Edit Categories
        </a>

      </div>

    </div>

  </article>
</section>

<section class="section">

  <div class="page-header">
    <div>
      <span class="eyebrow">PROJECT CATEGORIES</span>
      <h2>Categories</h2>
    </div>
  </div>

  <div class="card-grid">

    <% if (categories.length > 0) { %>

      <% categories.forEach((category) => { %>

        <article class="category-card">

          <div class="category-content">

            <h3>
              <a href="/category/<%= category.category_id %>">
                <%= category.name %>
              </a>
            </h3>

          </div>

        </article>

      <% }) %>

    <% } else { %>

      <p>
        No categories are currently assigned to this project.
      </p>

    <% } %>

  </div>

</section>

<%- include("partials/footer") %>
